{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "test", "*.log", "src"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "public": "hosting",
    "predeploy": ["node \"$PROJECT_DIR/functions/scripts/privacy-page.mjs\""],
    "ignore": ["firebase.json", "**/node_modules/**"]
  },
  "emulators": {
    "singleProjectMode": false,
    "auth": { "host": "0.0.0.0", "port": 9099 },
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "functions": { "host": "0.0.0.0", "port": 5001 },
    "ui": { "enabled": true, "host": "0.0.0.0", "port": 4000 }
  }
}
