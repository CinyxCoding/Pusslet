rules_version = '2';

// Pusslet security rules. Principles:
// - Only members of a family (an access doc for their uid) can read or write its data.
// - Parents can write everything; caregivers (e.g. a grandparent) see what is shared with them and can check things off.
// - Every client write is stamped: updatedBy == caller and updatedAt == server time (the sync engine always does this).
// - Clients never hard-delete family data; deletion is soft (deletedAt) or done by a Cloud Function.
// - A family document with shared == true is a space two homes share for their children (ADR-056): it only holds the
//   children's collections, and the parents of its homes may join it without an invite. Each home manages only its own
//   adults, its own place in the space and the costs it added (ADR-059).
// - An invite code is used once (ADR-059).
// Tests: functions/test/rules.test.ts (run against the emulator in CI).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function accessDoc(fid) { return get(/databases/$(database)/documents/families/$(fid)/access/$(me())); }
    function isMember(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/access/$(me()));
    }
    function isParent(fid) { return isMember(fid) && accessDoc(fid).data.role == 'parent'; }
    function isCaregiver(fid) { return isMember(fid) && accessDoc(fid).data.role == 'caregiver'; }
    function myMemberId(fid) { return accessDoc(fid).data.memberId; }

    function data() { return request.resource.data; }
    function stamped() { return data().updatedBy == me() && data().updatedAt == request.time; }
    function changed() { return data().diff(resource == null ? {} : resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys.concat(['updatedAt', 'updatedBy'])); }
    function reasonableSize() { return data().size() <= 64; }
    function shortString(v, max) { return v is string && v.size() <= max; }
    function optString(field, max) { return !(field in data()) || shortString(data()[field], max); }
    function softDeleteOnly() { return onlyChanges(['deletedAt']) && data().deletedAt == request.time; }
    function sharedWithCaregivers() { return resource.data.get('sharedWithCaregivers', false) == true; }
    function isSpace(fid) { return get(famPath(fid)).data.get('shared', false) == true; }
    // The home an adult in a space belongs to (ADR-059): written when they join, so a home manages only its own.
    function homeOf(access) { return access.get('home', access.get('viaFamily', '')); }
    // What a space shared with the other home may hold (Collections.inSpaces in the app; members are matched below).
    function spaceCollection(collection) {
      return collection in ['children', 'custodySchedules', 'events', 'packingRules', 'packingChecks', 'tasks',
        'handoffRequests', 'dietProfiles', 'schoolLunches', 'wishes', 'sickDays', 'handoffReceipts', 'medicineLog',
        'medicineCourses', 'staySchedules', 'expenses'];
    }

    // ---------- per-collection validation ----------
    function validEvent() {
      return shortString(data().title, 300) && data().start is string && data().end is string
        && optString('location', 300) && optString('note', 5000) && optString('rrule', 500)
        && (!('participantIds' in data()) || data().participantIds is list)
        && (!('sharedWithCaregivers' in data()) || data().sharedWithCaregivers is bool);
    }
    function validItem(listId) {
      return shortString(data().name, 200) && data().listId == listId && optString('note', 500)
        && (!('checked' in data()) || data().checked is bool);
    }
    function validTask() {
      return shortString(data().title, 300) && optString('note', 5000)
        && (!('sharedWithCaregivers' in data()) || data().sharedWithCaregivers is bool);
    }
    function validRecipe() {
      return shortString(data().title, 300) && (!('ingredients' in data()) || data().ingredients is list)
        && (!('steps' in data()) || data().steps is list);
    }
    function validNamed(field) { return shortString(data()[field], 200); }
    // "Kalas", "Matlådor": a name and recipe id -> true (a map, so phones merge per recipe).
    function validRecipeCollection() {
      return validNamed('name') && (!('recipeIds' in data()) || data().recipeIds is map);
    }
    // "Hämtad ✓" (ADR-048): who ticked off which hand-off, for which children.
    function validReceipt() {
      return shortString(data().eventId, 200) && shortString(data().occurrenceDate, 10)
        && data().kind in ['pickup', 'dropoff'] && data().doneBy is string
        && (!('childIds' in data()) || data().childIds is list);
    }
    // A child home sick (ADR-047): one per child and day; the rest are flags and who stays home.
    function validSickDay() {
      return shortString(data().childId, 100) && shortString(data().date, 10)
        && (!('vab' in data()) || data().vab is bool) && optString('homeWith', 100);
    }
    // Medicine and fever (ADR-050): parents only (not in caregiverReadable), short texts, a body temperature.
    function validMedicineEntry() {
      return shortString(data().childId, 100) && optString('medicine', 200) && optString('dose', 100)
        && (!('temperature' in data()) || data().temperature == null
          || (data().temperature is number && data().temperature >= 30 && data().temperature <= 45));
    }
    function validMedicineCourse() {
      return shortString(data().childId, 100) && shortString(data().medicine, 200) && optString('dose', 100)
        && data().times is list && data().times.size() <= 6 && data().days is number && data().days >= 1 && data().days <= 90;
    }

    // A cost shared with the other home (ADR-057): a title, an amount in öre and how much the other home pays.
    function validExpense() {
      return shortString(data().title, 200) && data().amountOre is int && data().amountOre > 0
        && data().amountOre <= 100000000 && shortString(data().paidByHome, 128)
        && (!('otherSharePercent' in data()) || (data().otherSharePercent is int
          && data().otherSharePercent >= 0 && data().otherSharePercent <= 100));
    }
    // A wish on a child's list (ADR-054).
    function validWish() { return shortString(data().text, 300) && data().childId is string && optString('link', 2000); }

    function validFor(collection) {
      return collection == 'events' ? validEvent()
        : collection == 'tasks' ? validTask()
        : collection == 'recipes' ? validRecipe()
        : collection == 'recipeCollections' ? validRecipeCollection()
        : collection == 'sickDays' ? validSickDay()
        : collection == 'handoffReceipts' ? validReceipt()
        : collection == 'medicineLog' ? validMedicineEntry()
        : collection == 'medicineCourses' ? validMedicineCourse()
        : collection == 'wishes' ? validWish()
        : collection == 'expenses' ? validExpense()
        : collection == 'breakPlans' ? (shortString(data().eventId, 200) && (!('days' in data()) || data().days is map))
        : collection == 'staySchedules' ? (shortString(data().childId, 100) && (!('days' in data()) || data().days is map))
        : collection == 'children' ? validNamed('firstName')
        : collection == 'members' ? validNamed('displayName')
        : collection == 'shoppingLists' ? validNamed('name')
        : collection == 'stores' ? validNamed('name')
        : collection == 'icsSubscriptions' ? (validNamed('name') && shortString(data().url, 2000))
        : true;
    }

    // Collections caregivers can read without restriction / not at all. Allergies and diets (dietProfiles) are sensitive
    // and stay with the parents (UX plan §10.6).
    function caregiverReadable(collection) {
      return collection in ['members', 'children', 'custodySchedules', 'packingRules', 'packingChecks', 'mealPlans',
        'recipes', 'shoppingLists', 'stores', 'pantry', 'handoffRequests', 'presence', 'settings',
        'aisleOverrides', 'ingredientMappings', 'favoriteWeeks', 'schoolLunches', 'recipeCollections', 'sickDays',
        'handoffReceipts', 'breakPlans', 'wishes'];
    }
    function caregiverFiltered(collection) { return collection in ['events', 'tasks']; }

    // ---------- users ----------
    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;
      match /devices/{deviceId} {
        allow read, write: if signedIn() && me() == userId;
      }
    }

    // ---------- invites (knowing the code is the capability) ----------
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isParent(data().familyId) && data().createdBy == me()
        && data().role in ['parent', 'caregiver']
        && data().expiresAt is timestamp && data().expiresAt <= request.time + duration.value(15, 'd')
        && code.size() == 10;
      // A code is used once (ADR-059): the one who joins with it marks it in the same batch, and nothing else changes.
      allow update: if signedIn() && resource.data.get('usedBy', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == me() && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/access/$(me())).data.get('inviteCode', null) == code;
      allow delete: if signedIn() && isParent(resource.data.familyId);
    }

    // Secret calendar feed tokens (served by the familyCalendarFeed function, never read by clients).
    match /calendarFeeds/{token} {
      allow create: if isParent(data().familyId) && data().createdBy == me() && token.size() >= 24;
      allow delete: if signedIn() && isParent(resource.data.familyId);
      allow read, update: if false;
    }

    // Read-only handover cards shared with the other household via link.
    match /handoverShares/{token} {
      allow create: if isParent(data().familyId) && data().createdBy == me() && token.size() >= 24
        && data().expiresAt is timestamp && data().expiresAt <= request.time + duration.value(31, 'd');
      allow delete: if signedIn() && isParent(resource.data.familyId);
      allow read, update: if false;
    }

    // Tombstones written by the deleteFamily/deleteAccount functions (only a timestamp). A deleted family can never be
    // created again, so a phone that still has it offline cannot bring it back; knowing the id lets a phone check
    // whether its family was deleted.
    match /deletedFamilies/{fid} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // ---------- families ----------
    match /families/{fid} {
      allow read: if isMember(fid);
      allow create: if signedIn() && data().createdBy == me() && stamped() && shortString(data().name, 100)
        && !exists(/databases/$(database)/documents/deletedFamilies/$(fid));
      allow update: if isParent(fid) && stamped() && data().createdBy == resource.data.createdBy && shortString(data().name, 100)
        && data().get('shared', false) == resource.data.get('shared', false)
        && (!resource.data.get('shared', false) || onlyMyHomeComesOrGoes());
      allow delete: if false;

      // In a space a home adds or takes away only itself from the homes taking part (ADR-059).
      function onlyMyHomeComesOrGoes() {
        let before = resource.data.get('familyIds', []).toSet();
        let after = data().get('familyIds', []).toSet();
        let moved = before.difference(after).union(after.difference(before));
        return moved.size() == 0 || moved.hasOnly([homeOf(accessDoc(fid).data)]);
      }

      function validInvite(code, role, memberId) {
        let inv = get(/databases/$(database)/documents/invites/$(code)).data;
        return code is string && inv.familyId == fid && inv.role == role && inv.expiresAt > request.time
          && inv.get('usedBy', null) == null
          && getAfter(/databases/$(database)/documents/invites/$(code)).data.get('usedBy', null) == me()
          && claimable(inv.get('memberId', null), memberId);
      }

      // In a space an adult says which home they come from, and must be a parent there (ADR-059).
      function joinsFromOwnHome(access) {
        let home = homeOf(access);
        let homeAccess = /databases/$(database)/documents/families/$(home)/access/$(me());
        return home is string && home != '' && home != fid && exists(homeAccess) && get(homeAccess).data.role == 'parent';
      }

      // In a space a home manages only its own adults; in a family the parents manage everyone.
      function sameHome(access) {
        return !isSpace(fid) || (homeOf(access) != '' && homeOf(access) == homeOf(accessDoc(fid).data));
      }

      // Who a joiner becomes: the member the invite names while nobody else has claimed it, or someone new (or the same
      // account coming back). Never a member who is already someone else's: that would be their name, pushes and requests.
      function claimable(invited, memberId) {
        let member = /databases/$(database)/documents/families/$(fid)/members/$(memberId);
        let owner = exists(member) ? get(member).data.get('uid', null) : null;
        return (invited == memberId && owner in [null, me()])
          || (invited == null && (!exists(member) || owner == me()));
      }

      // A parent of one of a shared space's homes joins it as the same person they are at home.
      function joinsViaHome(home, memberId) {
        let homeAccess = /databases/$(database)/documents/families/$(home)/access/$(me());
        return isSpace(fid) && home in get(famPath(fid)).data.get('familyIds', [])
          && exists(homeAccess) && get(homeAccess).data.role == 'parent' && get(homeAccess).data.memberId == memberId;
      }

      // Membership index used by every rule above. Doc id = Firebase uid.
      match /access/{userId} {
        allow read: if isMember(fid);
        allow create: if signedIn() && userId == me() && data().memberId is string && (
          // The creator only while the family is created in the same batch: one who was removed later stays out.
          (!exists(famPath(fid)) && getAfter(famPath(fid)).data.createdBy == me() && data().role == 'parent')
          || ('inviteCode' in data() && validInvite(data().inviteCode, data().role, data().memberId))
          || ('viaFamily' in data() && data().role == 'parent' && joinsViaHome(data().viaFamily, data().memberId))
        ) && (getAfter(famPath(fid)).data.get('shared', false) != true || joinsFromOwnHome(data()));
        allow update: if isParent(fid) && userId != me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && sameHome(resource.data);
        allow delete: if (isParent(fid) && sameHome(resource.data)) || (signedIn() && userId == me());
      }

      // Shopping items live under their list.
      match /shoppingLists/{listId}/items/{itemId} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && stamped() && reasonableSize() && (validItem(listId) || softDeleteOnly())
          && !isSpace(fid);
        allow delete: if false;
      }

      // Members: parents manage everyone; a joining adult creates their own member doc; anyone may edit their own.
      match /members/{memberId} {
        // My access doc as it is after this write: joining writes it in the same batch, so only getAfter() sees it.
        function myAccessAfter() { return getAfter(/databases/$(database)/documents/families/$(fid)/access/$(me())).data; }
        // The role a member shows is the one their access gives them (the app always writes it).
        function roleOfMyAccess() { return data().get('role', 'parent') == myAccessAfter().role; }

        allow read: if isMember(fid);
        allow create: if signedIn() && stamped() && validNamed('displayName') && (
          isParent(fid)
          || (myAccessAfter().memberId == memberId && data().get('uid', '') == me() && roleOfMyAccess())
        );
        // The last branch is joining through an invite that claims an existing member ("Johan" added by Sara), or coming
        // back as the same person. Editing yourself keeps the account and the role: only a parent changes those.
        allow update: if stamped() && validNamed('displayName') && reasonableSize() && (
          (isMember(fid) && (isParent(fid) || (myMemberId(fid) == memberId
            && data().get('uid', null) == resource.data.get('uid', null)
            && data().get('role', null) == resource.data.get('role', null))))
          || (data().get('uid', '') == me()
              && resource.data.get('uid', null) in [null, me()]
              && myAccessAfter().memberId == memberId
              && roleOfMyAccess())
        );
        allow delete: if false;
      }

      match /{collection}/{docId} {
        // A caregiver's own key in a request's declines, and nothing else in it.
        function onlyMyDecline() {
          return onlyChanges(['declines'])
            && data().declines.diff(resource.data.get('declines', {})).affectedKeys().hasOnly([myMemberId(fid)]);
        }
        // Answers (ADR-030): yes or no to an open request to me or to anyone (not my own), only the answer fields.
        function caregiverAnswer() {
          return resource != null && resource.data.status == 'pending'
            && resource.data.fromMemberId != myMemberId(fid)
            && (resource.data.get('toMemberId', null) == null || resource.data.toMemberId == myMemberId(fid))
            && ((onlyChanges(['status', 'respondedBy', 'respondedAt']) && data().status in ['accepted', 'declined']
                  && data().respondedBy == myMemberId(fid))
                || onlyMyDecline());
        }
        // "Ändra svar": until a parent's phone has written the answer into the event (appliedAt).
        function caregiverChangeAnswer() {
          return resource != null && resource.data.get('appliedAt', null) == null
            && ((resource.data.get('respondedBy', null) == myMemberId(fid) && data().status == 'pending'
                  && onlyChanges(['status', 'respondedBy', 'respondedAt']))
                || onlyMyDecline());
        }
        // "Jag kan inte idag": a new open request from me to the whole family.
        function caregiverAsk() {
          return resource == null && data().fromMemberId == myMemberId(fid)
            && data().get('toMemberId', null) == null && data().status == 'pending';
        }

        // What a caregiver may change: tick off packing, answer hand-off requests, mark shared tasks done, show presence.
        function caregiverWrite(collection) {
          return collection == 'packingChecks'
            || (collection == 'handoffRequests' && (caregiverAnswer() || caregiverChangeAnswer() || caregiverAsk()))
            || (collection == 'presence' && docId == myMemberId(fid))
            // "Hämtad" (ADR-048): his own receipt, and taking it back.
            || (collection == 'handoffReceipts' && data().doneBy == myMemberId(fid) && (validReceipt() || softDeleteOnly()))
            || (collection == 'tasks' && resource != null && sharedWithCaregivers()
                && onlyChanges(['done', 'doneAt', 'doneBy', 'completions', 'checklist', 'approved']))
            // A grandparent marks a wish as bought (ADR-054), nothing else.
            || (collection == 'wishes' && resource != null && onlyChanges(['taken', 'takenBy']));
        }

        // A shared cost (ADR-057) is added in the name of my own home and by me, and only that home changes or removes it
        // (ADR-059). Costs from before there was a home on them can be handled by either home.
        function ourCost() {
          let mine = homeOf(accessDoc(fid).data);
          return resource == null
            ? (mine != '' && data().get('addedByHome', '') == mine && data().get('createdBy', '') == myMemberId(fid))
            : (resource.data.get('addedByHome', null) == null
                || (resource.data.addedByHome == mine && data().get('addedByHome', null) == resource.data.addedByHome
                    && data().get('createdBy', null) == resource.data.get('createdBy', null)));
        }

        allow read: if collection != 'access' && collection != 'members' && isMember(fid) && (
          isParent(fid)
          || (isCaregiver(fid) && caregiverReadable(collection))
          || (isCaregiver(fid) && caregiverFiltered(collection) && sharedWithCaregivers())
        );

        allow create, update: if collection != 'access' && collection != 'members' && stamped() && reasonableSize() && (
          (isParent(fid) && (validFor(collection) || softDeleteOnly()) && (collection != 'expenses' || ourCost()))
          || (isCaregiver(fid) && caregiverWrite(collection))
        ) && (spaceCollection(collection) || !isSpace(fid));
        allow delete: if false;

      }
    }
  }
}
